<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Class Suite"
       parallel="classes"
       thread-count="3">

    <test name="Regression Tests">
        <classes>

            <class name="ConsoleLogs"/>
            <class name="ElementPositionWithGetRect"/>
            <class name="Geolocation"/>
            <class name="NetworkConditions"/>
            <class name="RelativeLocators"/>
            <class name="Screenshots"/>
            <class name="WindowAndTabManagement"/>

        </classes>
    </test>

</suite>
