<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Class Suite"
       parallel="classes"
       thread-count="3">

    <test name="Regression Tests">
        <classes>

            <class name="ConsoleLogsTests"/>
            <class name="ElementPositionWithGetRectTests"/>
            <class name="GeolocationTests"/>
            <class name="NetworkConditionsTests"/>
            <class name="RelativeLocatorsTests"/>
            <class name="ScreenshotsTests"/>
            <class name="WindowAndTabManagementTests"/>

        </classes>
    </test>

</suite>
